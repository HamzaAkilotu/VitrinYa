@model List<Order>
@{ ViewData["Title"] = "Siparişlerim"; ViewData["Panel"] = true; }
<div class="page-heading">
    <div class="eyebrow">SENİN SEÇİMLERİN</div>
    <h1>Siparişlerim</h1>
    <p>Güzel keşiflerinin geçmişi burada.</p>
</div>
@if (Model.Count == 0) { <div class="empty">
    <h2>Henüz siparişin yok.</h2>
    <a class="button" asp-controller="Home" asp-action="Catalog">Vitrini keşfet</a>
</div> }
@foreach (var order in Model) { <a class="order-card" asp-action="Details" asp-route-id="@order.Id">
    <div>
        <b>VY-@order.Id.ToString("D6")</b>
        <p>@order.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy · HH:mm") · @order.Items.Sum(x => x.Quantity) ürün</p>
    </div>
    <span class="badge">@order.Status</span>
    <strong>@order.Total.ToString("N2") TL →</strong>
</a> }

<partial name="_Pager" />
