@model List<StockTransaction>
@{ ViewData["Title"] = "Stok hareketleri"; ViewData["Panel"] = true; }
<div class="page-heading">
    <div class="eyebrow">HER ADETİN BİR KAYDI VAR</div>
    <h1>Stok hareketleri</h1>
    <p>Sipariş ve manuel stok değişikliklerinin tamamı, sayfalar halinde.</p>
</div>
@if (Model.Count == 0) { <div class="empty">
    <h2>Henüz stok hareketi yok.</h2>
</div> }
else { <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>TARİH</th>
                <th>ÜRÜN</th>
                <th>DEĞİŞİM</th>
                <th>NEDEN</th>
                <th>İŞLEMİ YAPAN</th>
            </tr>
        </thead>
        <tbody>@foreach (var t in Model) { <tr>
                <td>@t.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@t.Product.Name</td>
                <td>
                    <b>@(t.QuantityChange > 0 ? "+" : "")@t.QuantityChange</b>
                </td>
                <td>@t.Reason @if (t.OrderId.HasValue) { <small>VY-@t.OrderId.Value.ToString("D6")</small> }</td>
                <td>@(t.Reason == "Sipariş" && User.IsInRole(Roles.Seller) ? "Müşteri siparişi" : t.Actor.DisplayName)</td>
            </tr> }</tbody>
    </table>
</div> }

<partial name="_Pager" />
